# ============================================================
# LE JARDIN DE BLOOM — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs.
# Aucune de ces variables ne doit être préfixée NEXT_PUBLIC_ :
# elles ne sont lues que côté serveur.
# ============================================================

# --- Base de données (PostgreSQL, requis) ---
# Utilisée par Prisma. Exemple Vercel Postgres / Supabase / Neon / local.
DATABASE_URL="postgresql://user:password@localhost:5432/jardin_de_bloom"

# --- Authentification (Auth.js, requis) ---
# Secret de signature des sessions. Générer avec: openssl rand -base64 32
AUTH_SECRET="change-me"
# URL publique de l'app (utilisée par Auth.js pour les callbacks)
AUTH_URL="http://localhost:3000"

# --- Stockage objet des photos (optionnel) ---
# Si absent, MockStorageProvider écrit dans public/uploads (dev uniquement).
STORAGE_PROVIDER="mock" # "mock" | "s3" | "supabase"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""

# --- IA (optionnel) ---
# Si absent, MockVisionProvider / MockBloomProvider sont utilisés.
AI_PROVIDER="mock" # "mock" | "real"
AI_API_KEY=""

# --- Météo (optionnel) ---
# Si absent, MockWeatherProvider est utilisé.
WEATHER_PROVIDER="mock" # "mock" | "real"
WEATHER_API_KEY=""

# --- Divers ---
NODE_ENV="development"
